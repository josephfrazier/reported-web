# geoclient keys
# As of December 22, 2023, I think this might be the place to sign up instead: https://api-portal.nyc.gov/api-details#api=geoclient&operation=geoclient
# go here and register: https://developer.cityofnewyork.us/api/geoclient-api
# https://developer.cityofnewyork.us/ for more info
GEO_APP_ID=
GEO_APP_KEY=

# go to https://developers.google.com/maps/documentation/geocoding/start?hl=en_US#get-a-key
GOOGLE_API_KEY=

# HEROKU_APP_NAME must be set on Heroku, but not locally,
# as described in https://devcenter.heroku.com/articles/dyno-metadata
# HEROKU_APP_NAME='reported-web'

HEROKU_RELEASE_VERSION=v-1
OPENALPR_SECRET_KEY=
PARSE_APP_ID=APPLICATION_ID
PARSE_JAVASCRIPT_KEY=JAVASCRIPT_KEY
PARSE_MASTER_KEY=MASTER_KEY
PARSE_SERVER_URL=http://localhost:1337/parse
PLATERECOGNIZER_TOKEN=

# Sentry: errors and logs from the server and the browser. The DSN is public
# by design; the Sentry project settings show it. Leave it empty to disable.
SENTRY_DSN=

# Sentry source map upload, used by release builds. This token can write to
# the organization, so never commit it; a local release build can also put
# it in .env.sentry-build-plugin, which the bundler plugin reads.
# SENTRY_AUTH_TOKEN=

# Show the "NOT PRODUCTION" banner on the home page, displaying the Parse
# server in use. Set automatically for Heroku review apps (see app.json
# `environments.review`); set locally to preview the banner:
# SHOW_PARSE_SERVER_BANNER=true
#
# Heroku sets HEROKU_PR_NUMBER and HEROKU_BRANCH on review apps, and the
# banner links to whichever it finds; set them locally to preview the link:
# HEROKU_PR_NUMBER=1046
SHOW_PARSE_SERVER_BANNER=
